{
    "manifest_version": 3,
    "name": "AutoSPD for YouTube — AI 智慧播放速度",
    "version": "1.2.0",
    "minimum_chrome_version": "111",
    "description": "依影片內容自動調整 YouTube 播放速度：用關鍵字、YouTube 分類或本機 AI 判斷，支援頻道規則，直播與音樂固定 1x。",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
    ],
    "options_page": "options.html",
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
            "js": ["yt-categories.js", "content.js"],
            "css": ["content.css"],
            "run_at": "document_idle"
        },
        {
            "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
            "js": ["page-bridge.js"],
            "run_at": "document_idle",
            "world": "MAIN"
        }
    ],
    "background": {
        "service_worker": "background.js"
    }
}
