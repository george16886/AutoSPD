{
    "manifest_version": 3,
    "name": "AutoSPD - YouTube 智慧播放速度",
    "version": "1.1.0",
    "minimum_chrome_version": "111",
    "description": "根據影片類型自動調整 YouTube 播放速度，支援自訂分類與速度設定",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
            "js": ["content.js"],
            "css": ["content.css"],
            "run_at": "document_idle"
        },
        {
            "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
            "js": ["page-bridge.js"],
            "run_at": "document_idle",
            "world": "MAIN"
        }
    ],
    "background": {
        "service_worker": "background.js"
    }
}
